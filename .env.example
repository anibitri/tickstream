# Copy to .env (git-ignored) and fill in. `make up` reads this file.

# TODO(you): LocalStack auth token — create a free account at https://app.localstack.cloud
# and copy the token from "Auth Tokens". Leave empty if your LocalStack image runs without one.
LOCALSTACK_AUTH_TOKEN=

# TODO(you, optional): Discord or Slack incoming-webhook URL for alert notifications.
# Leave empty to disable webhook delivery (alerts are still written to DynamoDB).
ALERT_WEBHOOK_URL=

# Symbols to track (canonical BASE-QUOTE form).
SYMBOLS=BTC-USD,ETH-USD,SOL-USD
