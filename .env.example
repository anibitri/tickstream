# Copy to .env (git-ignored) and fill in. `make up` reads this file.

# Required: LocalStack auth token. Create a free account at https://app.localstack.cloud
# and copy the token from "Auth Tokens" (no space after the =).
LOCALSTACK_AUTH_TOKEN=

# Optional: Discord or Slack incoming-webhook URL for alert notifications.
# Leave empty to disable webhook delivery (alerts are still written to DynamoDB).
ALERT_WEBHOOK_URL=

# Symbols to track (canonical BASE-QUOTE form).
SYMBOLS=BTC-USD,ETH-USD,SOL-USD
